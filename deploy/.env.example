# Copy to the repo root as `.env` before running docker compose:
#   cp deploy/.env.example .env
# Never commit the real .env — it is ignored by .gitignore.

# ---------- database (docker compose) ----------
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pharmacy
# Host port mapping for the db container.
POSTGRES_PORT=5432

# ---------- backend: api & worker ----------
# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Listen address of the api service.
HTTP_ADDR=:8080
# Required. Inside docker compose the host is `db`, not `localhost`.
DATABASE_URL=postgres://pharmacy:change-me-locally@localhost:5432/pharmacy?sslmode=disable
# Max pooled connections per service instance.
DB_MAX_CONNS=10
# Per-query timeout. AGENT.md budget: database calls stay under 3s.
DB_TIMEOUT=3s
# Whole-request timeout enforced by middleware.
HTTP_REQUEST_TIMEOUT=15s
# Grace period for in-flight requests on shutdown.
SHUTDOWN_TIMEOUT=10s
# Max accepted request body size in bytes (1 MiB).
HTTP_MAX_BODY_BYTES=1048576

# ---------- frontend: web ----------
# Public site origin, used for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend base URL used by Server Components. Inside docker: http://api:8080
API_BASE_URL=http://localhost:8080

# ---------- ingest thresholds ----------
PRICE_JUMP_RATIO=0.70
OFFER_STALE_AFTER=24h
OFFER_CRITICAL_AFTER=72h
CRAWL_TIMEOUT=15s

# ---------- optional public accounts (M6) ----------
# HMAC-ish pepper mixed into OTP hashes. Required (>=16 chars) in production.
OTP_PEPPER=dev-only-otp-pepper
# Print OTP to process stdout (never slog) for local login. Must be false in production.
OTP_PRINT_CODE=true

# ---------- worker health ----------
WORKER_HTTP_ADDR=:8081

# ---------- launch / TLS (profile: launch) ----------
# Real public hostname. Caddy obtains a Let's Encrypt cert when this is not localhost.
SITE_DOMAIN=localhost
CADDY_EMAIL=admin@localhost

# ---------- backups ----------
# Directory for pg_dump archives (deploy/backup.sh).
BACKUP_DIR=deploy/backups

# ---------- first ops user (profile: ops) ----------
OPS_USERNAME=ops
OPS_PASSWORD=ops-dev-password
OPS_ROLE=super_admin
